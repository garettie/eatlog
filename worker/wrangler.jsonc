{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eatlog-food",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "secrets": {
    "required": ["USDA_API_KEY", "GEMINI_API_KEY", "RATE_LIMIT_SALT"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    { "name": "USDA_INSTALL_LIMITER", "namespace_id": "41001", "simple": { "limit": 30, "period": 60 } },
    { "name": "USDA_IP_LIMITER", "namespace_id": "41002", "simple": { "limit": 300, "period": 60 } },
    { "name": "USDA_EMERGENCY_LIMITER", "namespace_id": "41003", "simple": { "limit": 1000, "period": 60 } },
    { "name": "GEMINI_INSTALL_LIMITER", "namespace_id": "42001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GEMINI_IP_LIMITER", "namespace_id": "42002", "simple": { "limit": 30, "period": 60 } },
    { "name": "GEMINI_EMERGENCY_LIMITER", "namespace_id": "42003", "simple": { "limit": 100, "period": 60 } }
  ]
}
