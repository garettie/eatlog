# Copy to .env.local and fill in what you need. Everything is optional:
# with nothing set you get the local app plus My key.

# Your own Worker from worker/README.md, for USDA search and Eatlog AI
EXPO_PUBLIC_FOOD_WORKER_URL=

# Your RevenueCat public SDK key, for purchases
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Links shown in the app
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
