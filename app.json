{
  "expo": {
    "name": "Eatlog",
    "slug": "eatlog",
    "version": "1.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151515",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sgaret.eatlog",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Eatlog to take meal photos for local reuse or estimates you request.",
        "NSPhotoLibraryUsageDescription": "Allow Eatlog to choose meal photos for local reuse or estimates you request."
      }
    },
    "android": {
      "package": "com.sgaret.eatlog",
      "adaptiveIcon": {
        "backgroundColor": "#151515",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#151515",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-sqlite",
      "./plugins/withEatlogHealthConnect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eatlog to choose meal photos for local reuse or estimates you request.",
          "cameraPermission": "Allow Eatlog to take meal photos for local reuse or estimates you request.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Eatlog to choose meal photos for local reuse or estimates you request.",
          "savePhotosPermission": "Allow Eatlog to save share images to your photo library.",
          "granularPermissions": []
        }
      ],
      "./plugins/withEatlogMediaPermissions",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "700befb6-016e-4d35-a35c-bd375da07e4d"
      }
    },
    "owner": "sgaret"
  }
}
