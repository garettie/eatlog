{
  "expo": {
    "name": "Marco",
    "slug": "marco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111318",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.marco.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#111318",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-scale-static.png",
      "resizeMode": "contain",
      "backgroundColor": "#111318"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111318",
          "image": "./assets/splash-scale-static.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to scan food labels for nutritional information",
          "cameraPermission": "Used to scan food labels with the camera"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "bffe0ee2-d580-4ad2-8fa1-ae76f16279c3"
      }
    },
    "owner": "yoshibig"
  }
}
