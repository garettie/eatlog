  "narrative": {
    "northStar": "The Adaptive Training Instrument",
    "overview": "Eatlog is a serious, calm nutrition instrument for Android and iOS. Its dark Material 3 surface stack keeps energy, macros, weight trends, and adaptive recommendations prominent without gamification. Large tabular figures establish the current state, while tonal surfaces and hairline boundaries establish hierarchy without shadows. Real meal photos carry identity through logging and review; deterministic food icons cover entries without photos.",
    "keyCharacteristics": ["Tonal dark Material 3 layering, not gradients or glass.", "Real Onest weights and tabular numeric hierarchy.", "Photo-first meal logging with deterministic icon fallback.", "Rounded surfaces with hairline boundaries, not floating shadow stacks.", "Android-native sheets, Back behavior, and reduced-motion support."],
    "rules": [
      { "name": "Photo-First Rule", "body": "Camera capture and gallery import lead to Identify meal. Local history reuse comes before an explicit new estimate; search and manual entry remain capable fallbacks.", "section": "overview" },
      { "name": "Nutrient Meaning Rule", "body": "Protein is rose, carbs are green, fat is gold, and expenditure is lavender on every screen.", "section": "colors" },
      { "name": "Nutrient Overflow Rule", "body": "The first target cycle uses the nutrient base color. Intake above target refills from the start in the darker same-hue overflow token. The dashboard calorie ring is the White Action exception, with an Ink overflow arc.", "section": "colors" },
      { "name": "Stable Figure Rule", "body": "Calories, grams, dates, trend weights, and editable measurement values always use tabular numerals.", "section": "typography" },
      { "name": "Tonal Elevation Rule", "body": "Use a higher surface token to distinguish an active or selected element. Never add a shadow to compensate for weak hierarchy.", "section": "elevation" }
    ],
    "dos": ["Do use tonal surfaces and hairline outline-variant borders.", "Do gate motion through reduced-motion behavior.", "Do use real scanned thumbnails with deterministic food icons as fallback.", "Do keep the center Add control as an action rather than a navigation destination."],
    "donts": ["Don't add gamification noise, gradients, glassmorphism, or drop shadows.", "Don't use cream or sand SaaS neutrals or mascot copy.", "Don't create per-screen component styles.", "Don't expose API credentials or inert cloud-sync controls."]
